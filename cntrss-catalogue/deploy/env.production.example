# Copier vers .env (à la racine) puis compléter : cp deploy/env.production.example .env
# Aucune valeur n'est fictive ici sauf mention « à générer ».

# --- Réseau ---
PORT=3000
# Origine publique exacte (scheme + domaine), utilisée dans les liens envoyés
# par e-mail (réinitialisation du mot de passe).
APP_ORIGIN=https://cntrss.bj
# Origines autorisées par CORS (virgule séparée). Vide = same-origin uniquement.
CORS_ORIGINS=https://cntrss.bj
# Nombre de sauts de reverse proxy devant Express (nginx = 1). Indispensable
# pour que le rate limiting par IP et le journal d'audit voient la vraie IP.
TRUST_PROXY=1

# --- Base de données et fichiers ---
# SQLite relatif au dossier prisma/ ; utiliser un chemin absolu en production
# pour que la base survive aux redéploiements.
DATABASE_URL="file:/var/lib/cntrss/prisma/prod.db"
# Dossier des PDF déposés : à sauvegarder avec la base.
UPLOADS_DIR=/var/lib/cntrss/uploads
MAX_UPLOAD_BYTES=15728640

# --- Sécurité ---
NODE_ENV=production
# Cookies de session Secure (requis derrière HTTPS ; la valeur par défaut en
# production est déjà "true", on l'écrit explicitement).
COOKIE_SECURE=true
# Boutons de connexion rapide désactivés + identifiants non exposés.
ENABLE_DEMO_LOGIN=false
# Mot de passe unique des 6 comptes créés par le seed (à générer :
# openssl rand -base64 18). Les mots de passe devront ensuite être changés par
# chaque titulaire (réinitialisation par e-mail).
DEMO_LOGIN_PASSWORD=à-générer
# Tentatives de connexion/inscription par IP et par 15 minutes.
LOGIN_MAX_ATTEMPTS=10
# Quota de l'assistant IA par IP et par minute.
ASSISTANT_MAX_REQUESTS_PER_MINUTE=60

# --- Services externes (optionnels) ---
# Assistant IA : sans clé, l'assistant répond sans appeler Gemini (repli local).
GEMINI_API_KEY=
# E-mails (demandes de partenariat, liens de réinitialisation) : sans clé,
# les demandes sont enregistrées mais l'envoi est journalisé comme indisponible.
RESEND_API_KEY=
PARTNER_ADMIN_EMAIL=admin@cntrss.bj
PARTNER_EMAIL_FROM="CNTRSS <notifications@cntrss.bj>"
