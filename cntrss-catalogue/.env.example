# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Base de données Prisma (schéma prisma/schema.prisma).
# Le chemin SQLite est relatif au dossier prisma/.
DATABASE_URL="file:./dev.db"

# PORT: Port d'écoute du serveur Express (défaut 3000).
PORT="3000"

# NODE_ENV: "production" sert le build dist/ au lieu du serveur Vite.
NODE_ENV="production"

# CORS_ORIGINS: Origines autorisées, séparées par des virgules.
CORS_ORIGINS="https://cntrss.bj"

# ENABLE_DEMO_LOGIN: "false" supprime les boutons de connexion rapide et
# n'expose plus les identifiants de démonstration via /api/auth/config
# (recommandé en production).
ENABLE_DEMO_LOGIN="true"

# DEMO_LOGIN_PASSWORD: mot de passe commun des comptes créés par le seed
# (défaut "Cntrss2026!"). À changer avant toute mise en ligne.
DEMO_LOGIN_PASSWORD="Cntrss2026!"

# COOKIE_SECURE: "true"/"false" force le drapeau Secure du cookie de session.
# Par défaut : activé si NODE_ENV=production (le site doit alors être servi en HTTPS).
COOKIE_SECURE="true"

# LOGIN_MAX_ATTEMPTS: tentatives de connexion/inscription par IP et par 15 minutes.
LOGIN_MAX_ATTEMPTS="10"

# RESEND_API_KEY: clé API Resend des e-mails transactionnels (demandes de
# partenariat, liens de réinitialisation de mot de passe). Sans clé, les
# e-mails ne partent pas : les données restent enregistrées en base et
# l'absence d'envoi est journalisée.
RESEND_API_KEY="re_xxxxxxxx"

# PARTNER_ADMIN_EMAIL: destinataire des demandes de partenariat.
PARTNER_ADMIN_EMAIL="admin@cntrss.bj"

# PARTNER_EMAIL_FROM: expéditeur des e-mails (domaine vérifié chez Resend).
PARTNER_EMAIL_FROM="CNTRSS <notifications@cntrss.bj>"

# APP_ORIGIN: origine publique utilisée dans les liens envoyés par e-mail
# (réinitialisation de mot de passe). Déduite de la requête si absente.
APP_ORIGIN="https://cntrss.bj"

# PASSWORD_RESET_MAX_ATTEMPTS: demandes de réinitialisation par IP/15 minutes.
PASSWORD_RESET_MAX_ATTEMPTS="5"

# UPLOADS_DIR: dossier des PDF réellement déposés (défaut data/uploads).
UPLOADS_DIR="data/uploads"

# MAX_UPLOAD_BYTES: taille maximale d'un PDF déposé (défaut 15728640 = 15 Mo).
MAX_UPLOAD_BYTES="15728640"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUST_PROXY: nombre de sauts de reverse proxy devant Express (nginx = 1).
# Indispensable en production derrière un proxy : sinon toutes les requêtes
# partagent l'IP du proxy et le rate limiting par IP devient inopérant.
TRUST_PROXY=
