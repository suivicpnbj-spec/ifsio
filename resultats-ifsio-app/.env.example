# =============================================================================
# Configuration — copier ce fichier vers .env puis adapter les valeurs.
#   cp .env.example .env
#
# Sur un PaaS (Render/Railway/Fly), ces variables se renseignent dans le
# dashboard du service — jamais dans le dépôt. Voir render.yaml et le README
# (section « Mise en production »).
# =============================================================================

# Serveur
PORT=3000
NODE_ENV=development            # production en déploiement (Render le définit)

# Base de données (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false                  # true si base managée (Render/Neon/Supabase) : SSL obligatoire

# Authentification
JWT_SECRET=change_this_to_a_long_random_string   # impératif : valeur longue et aléatoire en production
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# SMS sortant — Africa's Talking (couvre le Bénin +229)
# Compte : africastalking.com → Dashboard → clé API (atsk_...) et nom d'utilisateur du compte
SMS_PROVIDER_API_URL=https://api.africastalking.com/version1/messaging
SMS_PROVIDER_API_KEY=atsk_votre_cle_api
SMS_PROVIDER_USERNAME=votre_username_compte
SMS_SENDER_ID=                # SenderID alphanumérique approuvé ; vide = code court par défaut

# Webhook SMS entrant — secret partagé obligatoire en production
# L'agrégateur doit signer ses requêtes : HMAC-SHA256(body, secret) dans l'en-tête X-IFSIO-Signature
# (Africa's Talking ne signe pas : protéger la route par un proxy ou limiter par IP en production)
SMS_WEBHOOK_SECRET=

# Email — SMTP générique (institutionnel, Gmail/Workspace, Resend, …)
# Laisser SMTP_HOST vide → mode simulation (envois journalisés en console)
#
# Exemple Resend (recommandé — smtp.resend.com, ~3000 emails/mois gratuits) :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxx          ← votre clé API Resend
#   EMAIL_FROM="IFSIO <no-reply@votre-domaine-verifie>"   (en test sans domaine : <onboarding@resend.dev>)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true si port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=IFSIO <no-reply@ifsio.up.bj>

# Divers
CORS_ORIGIN=*
# Secret de communication inter-services (eRésultats <-> Mes Actes)
CAMPUS_INTERNAL_SECRET=ifsio-campus-secret-key-parakou-2026
