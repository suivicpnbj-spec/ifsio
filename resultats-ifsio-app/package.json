{
  "name": "resultats-ifsio-api",
  "version": "1.0.0",
  "description": "API de la plateforme de consultation des r\u00e9sultats acad\u00e9miques - IFSIO, Universit\u00e9 de Parakou",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node db/migrate.js && node src/server.js",
    "build:frontend": "cd frontend && npm run build",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:db": "node db/migrate.js",
    "seed": "node db/seeds/run.js",
    "seed:beta:essfe-l2": "node db/seeds/seed-beta-essfe-l2.js",
    "seed:beta:essfe-l1-ide": "node db/seeds/seed-beta-essfe-l1-ide.js",
    "seed:beta:essfe-l3-referentiel": "node db/seeds/seed-beta-essfe-l3-referentiel.js",
    "admin:bootstrap": "node db/scripts/bootstrap-scolarite-admin.js",
    "test": "node --test",
    "test:email": "node send-test-email.js",
    "test:sms": "node send-test-sms.js",
    "db:offline:start": "bash scripts/offline-db.sh start",
    "db:offline:stop": "bash scripts/offline-db.sh stop",
    "db:offline:status": "bash scripts/offline-db.sh status",
    "migrate:offline": "DOTENV_CONFIG_PATH=.env.offline npm run migrate:db",
    "seed:offline:essfe-l2": "DOTENV_CONFIG_PATH=.env.offline NODE_ENV=development node db/seeds/seed-beta-essfe-l2.js",
    "dev:offline": "DOTENV_CONFIG_PATH=.env.offline npm run dev",
    "local": "bash scripts/start-local.sh"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "saxes": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
