{
  "name": "ifsio-portal-service",
  "version": "1.0.0",
  "private": true,
  "description": "Services indépendants du portail étudiant et éditorial IFSIO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "demo:seed": "node scripts/seed-demo.js",
    "db:local:start": "bash scripts/local.sh start",
    "db:local:stop": "bash scripts/local.sh stop",
    "local": "bash scripts/local.sh up",
    "admin:create": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
