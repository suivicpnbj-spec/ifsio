{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "server-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/types.ts",
    "src/data/acts.ts",
    "src/data/demo.ts",
    "src/data/establishment.ts",
    "src/lib/stats.ts",
    "src/lib/csv.ts",
    "src/lib/documents.ts"
  ],
  "exclude": ["node_modules", "dist", "server-dist", "**/*.test.ts"]
}
