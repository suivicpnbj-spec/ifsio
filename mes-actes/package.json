{
  "name": "mes-actes",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:api",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env server-dist/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "db:export:postgres": "node scripts/migrate-to-postgres.mjs",
    "test:e2e": "node scripts/e2e-api.mjs",
    "test:e2e:ui": "node scripts/e2e-ui.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
