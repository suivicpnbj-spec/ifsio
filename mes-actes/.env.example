# ─────────────────────────── Serveur ───────────────────────────
NODE_ENV=production
PORT=4000

# Obligatoire en production : `openssl rand -hex 32`
JWT_SECRET=

# URL publique de la plateforme (affichée sur les récépissés).
PUBLIC_BASE_URL=https://actes.ifsio.up.bj

# Derrière un reverse proxy (Nginx, Caddy, Render, Fly…) : nombre de proxies de confiance.
# Permet de journaliser la vraie IP client et de limiter les tentatives de connexion.
TRUST_PROXY=1

# ─────────────────────────── Persistance ───────────────────────────
DATABASE_FILE=./data/mes-actes.db
UPLOAD_DIR=./data/uploads

# Compte scolarité créé au premier démarrage (base vide, SEED_DEMO=false).
# Mot de passe de 12 caractères minimum ; à changer après la première connexion.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Direction
ADMIN_LAST_NAME=SCOLARITÉ

# ─────────────────────────── Front ───────────────────────────
SERVE_STATIC=true
STATIC_DIR=/app/dist

# ─────────────────────────── Paiement ───────────────────────────
# manual (quittance enregistrée par la scolarité) | mock | feexpay | cinetpay
PAYMENT_PROVIDER=manual

# FeeXPay — Mobile Money (MTN MoMo / Moov Money) et carte, httpS://feexpay.me
# Clé API « fp_… » et identifiant de boutique : tableau de bord marchand FeeXPay.
FEXPAY_API_TOKEN=
FEXPAY_SHOP_ID=
FEXPAY_BASE_URL=https://api-v2.feexpay.me
# URLs de retour après checkout (l'étudiant rejoint la plateforme).
FEXPAY_RETURN_URL=
FEXPAY_CANCEL_URL=

CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET=
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=

# ─────────────────────────── E-mails ───────────────────────────
# Accusé de réception + quittance envoyés automatiquement à la validation.
# Sans clé Resend, les e-mails sont journalisés dans data/outbox.log.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=MES ACTES <onboarding@resend.dev>

# Durées de session (secondes)
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600

# ─────────────────────────── Passerelle Campus IFSIO ───────────────────────────
RESULTATS_API_URL=http://localhost:3000
CAMPUS_INTERNAL_SECRET=ifsio-campus-secret-key-parakou-2026
